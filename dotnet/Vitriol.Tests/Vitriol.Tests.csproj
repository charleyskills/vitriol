<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vitriol.Tests</RootNamespace>
    <AssemblyName>Vitriol.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit's analyzer warnings shouldn't fail the build at this maturity. -->
    <NoWarn>$(NoWarn);xUnit1004;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vitriol.Core\Vitriol.Core.csproj" />
    <ProjectReference Include="..\Vitriol.Stone\Vitriol.Stone.csproj" />
    <ProjectReference Include="..\Vitriol.Formats.Text\Vitriol.Formats.Text.csproj" />
    <ProjectReference Include="..\Vitriol.Formats.Image\Vitriol.Formats.Image.csproj" />
    <ProjectReference Include="..\Vitriol.Formats.Tabular\Vitriol.Formats.Tabular.csproj" />
    <ProjectReference Include="..\Vitriol.Formats.Archive\Vitriol.Formats.Archive.csproj" />
    <ProjectReference Include="..\Vitriol.Formats.Crypto\Vitriol.Formats.Crypto.csproj" />
    <ProjectReference Include="..\Vitriol.Cli\Vitriol.Cli.csproj" />
  </ItemGroup>

</Project>
